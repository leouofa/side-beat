theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "[b]MOVE (2.5D BELT):[/b] WASD or Arrow Keys / Left Stick
[b]JUMP / DOUBLE JUMP:[/b] Space / South (A)
[b]LIGHT ATTACK (3-Hit):[/b] J or Z / West (X)
[b]HEAVY GUARD CRUSH:[/b] K or X / North (Y)
[b]UP-LAUNCHER SLAM:[/b] Up + Heavy (K)
[b]AERIAL JUGGLE:[/b] Light or Heavy in Mid-Air
[b]PERFECT PARRY (8-Frame):[/b] U or Shift / Left Trigger
[b]LANE BOWLING THROW:[/b] I or G / Right Bumper
[b]PANTHEON SPECIALS (25% Meter):[/b] L or C / East (B)
[b]PANTHEON SUPER (100% Meter):[/b] O or V / Right Trigger"

[node name="RightCol" type="VBoxContainer" parent="MarginContainer/VBoxContainer/HSplitContainer"]
